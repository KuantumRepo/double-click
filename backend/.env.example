# Go to: Automations → API keys → Create API key
# - Name: payment-collect-secret
# - Type: secret
REBILLY_API_SECRET_KEY=

# 2. Organization ID
# Go to: Settings → My organization & websites
# Copy Organization ID (looks like org_0YV...)
REBILLY_ORGANIZATION_ID=org_your_org_id_here

# 3. Website ID
# Same page as above (My organization & websites)
# Copy Website ID (looks like web_0YV...)
REBILLY_WEBSITE_ID=web_your_website_id_here

PORT=3001
